# App
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://wagering:wagering@localhost:5442/wagering

# SQS (LocalStack)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
WAGER_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Workers (úteis para desligar em testes)
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
PENDING_REFERENCE_WORKER_ENABLED=true

# Keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/wagering
KEYCLOAK_AUDIENCE=wagering-api
AUTH_ENABLED=true

# Migrations on boot (docker)
RUN_MIGRATIONS=false
